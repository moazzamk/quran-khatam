{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "khatam/khatam-table",
  "title": "Khatam Table",
  "category": "text",
  "description": "Adds a table for the current Quran Khatam.",
  "keywords": ["table"],
  "version": "1",
  "textdomain": "khatam",
  "editorScript": "file:./index.js",
  "viewScript": "file:./frontend.js",
  "script": "",
  "attributes": {
    "formBgColor": {
      "type": "string",
      "default": "rgba(150, 150, 150, .2)"
    },
    "textFieldBgColor": {
      "type": "string",
      "default": "rgba(1, 135, 134, .1)"
    },
    "submitBgColor": {
      "type": "string",
      "default": "#f87171"
    }
  },
  "style": "file:./index.css"
}
